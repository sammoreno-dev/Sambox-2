_net_format_bytes() {
    local bytes="${1:-0}"
    if [[ ${bytes} -lt 1024 ]]; then
        printf "%d B" "${bytes}"
    elif [[ ${bytes} -lt 1048576 ]]; then
        printf "%d KB" $(( bytes / 1024 ))
    elif [[ ${bytes} -lt 1073741824 ]]; then
        printf "%d MB" $(( bytes / 1024 / 1024 ))
    else
        printf "%d GB" $(( bytes / 1024 / 1024 / 1024 ))
    fi
}

_get_path_size_bytes() {
    local path="$1"
    if [[ -e "${path}" ]]; then
        # Extrai os bytes de forma rápida via comando de sistema sem sub-pipes
        du -sb "${path}" 2>/dev/null | cut -f1 || echo 0
    else
        echo 0
    fi
}

cleanup_scan() {
    local purge_trigger="${1:-0}"
    local total_bytes=0 found_count=0 dxvk_bytes=0
    local type="" label="" path="" line="" readable="" bytes=0
    local dxvk_files=() f="" b=0

    printf "\n${CYAN}${BOLD}  ╔═══════════════════════════════════════════╗\n"
    printf "  ║     🔍  VARREDURA DE SHADERS & CACHES     ║\n"
    printf "  ╚═══════════════════════════════════════════╝${RST}\n\n"

    printf "  ${BOLD}%-38s %-12s %s${RST}\n" "ALVO DE CACHE" "TAMANHO" "STATUS"
    _sep

    # Garante o isolamento do IFS local para não contaminar o motor mestre
    while IFS='|' read -r type label path; do
        [[ -n "${path}" ]] || continue

        if [[ -e "${path}" ]]; then
            bytes=$(_get_path_size_bytes "${path}")
            total_bytes=$(( total_bytes + bytes ))
            found_count=$(( found_count + 1 ))
            readable=$(_net_format_bytes "${bytes}")

            printf "  %-38s ${YELLOW}%-12s${RST} ${GREEN}Presente${RST}\n" "${label}" "${readable}"
            
            # Se o gatilho for 1, remove fisicamente o diretório de cache
            if [[ "${purge_trigger}" == "1" ]]; then
                rm -rf "${path}" 2>/dev/null || true
            fi
        else
            printf "  %-38s ${DIM}%-12s Ausente${RST}\n" "${label}" "0 B"
        fi
    # Alimenta o laço consumindo a função sob demanda contida no m_cleanup_data.sh
    done < <(_get_cache_targets_catalog)

    # Varredura de pipelines DXVK órfãos nas pastas de prefixos Wine
    if [[ -d "${HOME}/.wine" ]]; then
        while IFS= read -r -d '' f; do
            [[ -f "${f}" ]] || continue
            dxvk_files+=("${f}")
            b=$(_get_path_size_bytes "${f}")
            dxvk_bytes=$(( dxvk_bytes + b ))
            
            if [[ "${purge_trigger}" == "1" ]]; then
                rm -f "${f}" 2>/dev/null || true
            fi
        done < <(find "${HOME}/.wine" -name "*.dxvk-cache" -type f -print0 2>/dev/null)
    fi

    # Somatório final unificado
    total_bytes=$(( total_bytes + dxvk_bytes ))
    local total_readable=$(_net_format_bytes "${total_bytes}")

    _sep
    if [[ "${purge_trigger}" == "1" ]]; then
        _msg "Purga molecular concluída! Caches de shaders limpos. ツ"
        printf "    ${GREEN}🎉 Espaço liberado de forma bare-metal:${RST} ${BOLD}%s${RST}\n" "${total_readable}"
    else
        _msg "Varredura Dry-Run finalizada com sucesso! (ツ)"
        printf "    ${CYAN}💡 Total acumulado passível de limpeza:${RST} ${BOLD}%s${RST} em ${BOLD}%d${RST} alvos principais.\n" \
            "${total_readable}" "${found_count}"
        [[ ${#dxvk_files[@]} -gt 0 ]] && printf "    ${CYAN}🎮 Pipelines DXVK localizados:${RST} ${BOLD}%d arquivos .dxvk-cache${RST} órfãos.\n" "${#dxvk_files[@]}"
    fi
}

