menu_input_central() {
    local i_opt=""
    while true; do
        clear 2>/dev/null || true
        printf "\n${CYAN}${BOLD}  ╔═══════════════════════════════════════════╗\n"
        printf "  ║        🎮  DIAGNÓSTICO DE CONTROLES       ║\n"
        printf "  ╚═══════════════════════════════════════════╝${RST}\n\n"
        
        printf "  ${CYAN}${RST}  🛡️   Inspecionar Permissões de Usuário, Nós e Grupos\n"
        printf "  ${CYAN}${RST}  🎮  Escanear Controles e Joysticks Conectados (Kernel)\n"
        printf "  ${DIM}─────────────────────────────────────────────────────────────────${RST}\n"
        printf "  ${CYAN}${RST}  ⬅️   Voltar ao Menu Principal\n\n"

        read -rp "  $(printf "${BOLD}")Selecione uma opção de input [0-2]:$(printf "${RST}") " i_opt
        [[ "${i_opt}" == "0" || -z "${i_opt}" ]] && break

        case "${i_opt}" in
            1) input_check_permissions ;; # Chama a rotina isolada do m_input_core.sh
            2) input_list_devices ;;      # Chama a rotina isolada do m_input_core.sh
            *) _warn "Opção inválida para o subsistema de inputs." ;;
        esac
        printf "\n"; read -rp "  Pressione [ENTER] para continuar..." _
    done
}

# Auto-registro nativo e independente na mesa do motor mestre do Sambox 2
register_sambox_module "🎮  Input & Gamepads (Diagnóstico de Controles e Permissões)" "menu_input_central"
