# ── Carregamento Dinâmico e Seguro de Módulos ──────────────────────────────
_load_modules() {
    if [[ ! -d "${MODULES_DIR}" ]]; then
        _err "Diretório de módulos não encontrado!"
        _err "Caminho procurado: ${MODULES_DIR}"
        exit 1
    fi

    local mod_count=0
    local mod
    for mod in "${MODULES_DIR}"/*.sh; do
        [[ -f "${mod}" ]] || continue
        # shellcheck source=/dev/null
        if source "${mod}"; then
            mod_count=$(( mod_count + 1 ))
        else
            _err "Falha crítica ao carregar o módulo: ${mod}"
            exit 1
        fi
    done

    if [[ "${mod_count}" -eq 0 ]]; then
        _warn "Nenhum módulo .sh foi encontrado em ${MODULES_DIR}."
    fi
}

# ── Fallback Seguro para Chamadas de Módulos Opcionais ──────────────────────
_dispatch() {
    local func_name="$1"
    local fallback_msg="$2"
    shift 2 || true

    if declare -f "${func_name}" >/dev/null; then
        "${func_name}" "$@"
    else
        _err "Módulo não carregado ou função ausente: [${func_name}]"
        _warn "${fallback_msg}"
    fi
}

# ── Help / Uso do Utilitário CLI ───────────────────────────────────────────
_show_help() {
    echo "Sambox 2 Engine v${SAMBOX_VERSION} — Toolbox Gamer & Emulação Minimalista"
    echo "Uso: $0 [opção] [argumentos]"
    echo ""
    echo "Opções disponíveis:"
    echo "  --manual        Abre o leitor interativo de instruções e tuning"
    echo "  --clean         Executa a limpeza de caches de shaders e temporários"
    echo "  --wine          Invoca comandos da Central Wine (ex: --wine diag, --wine launch <exe>)"
    echo "  --retro         Invoca comandos da Central Retro (ex: --retro emulators, --retro init)"
    echo "  --input         Invoca comandos de diagnóstico de controles (ex: --input list, --input perms)"
    echo "  --version, -v   Exibe a versão do Sambox 2"
    echo "  --help, -h      Exibe este menu de ajuda"
}

# ── Menu Principal TUI ─────────────────────────────────────────────────────
_main_menu() {
    local choice
    while true; do
        _banner
        printf "  ${BOLD}MÓDULOS DISPONÍVEIS${RST}\n\n"
        printf "  ${CYAN}[1]${RST}  🍷  Wine/Proton — Gaming Orchestrator & Low-Level Tuning\n"
        printf "  ${CYAN}[2]${RST}  🕹️   Retro     — ROMs Organizer, BIOS Check & Emulators\n"
        printf "  ${CYAN}[3]${RST}  🎮  Input     — Gamepad Diagnostics & Real-time Event Monitor\n"
        printf "  ${CYAN}[4]${RST}  🧹  Cleanup   — Purge Shaders, DXVK State & Wine Bloat\n"
        printf "  ${CYAN}[5]${RST}  📖  Manual    — Leitor Interativo de Instruções & Tuning\n"
        printf "  ${DIM}────────────────────────────────────────────────${RST}\n"
        printf "  ${CYAN}[0]${RST}  ❌  Sair\n\n"

        read -rp "  $(printf "${BOLD}")Selecione [0-5]:$(printf "${RST}") " choice

        case "${choice}" in
            1) _dispatch "menu_wine_central"    "Módulo Wine (m_wine.sh) indisponível." ;;
            2) _dispatch "menu_retro_central"   "Módulo Retro (m_retro.sh) indisponível." ;;
            3) _dispatch "menu_input_central"   "Módulo Input (m_input.sh) indisponível." ;;
            4) _dispatch "menu_cleanup_central" "Módulo Cleanup (m_cleanup.sh) indisponível." ;;
            5) _show_manual ;;
            0) printf "\n"; _msg "Saindo do Sambox 2. Bom jogo!"; exit 0 ;;
            *) _warn "Opção inválida. Tente novamente." ;;
        esac

        printf "\n"
        read -rp "  Pressione [ENTER] para voltar ao menu..." _
        clear 2>/dev/null || true
    done
}

# ── Ponto de Entrada do Motor (Main Execution) ─────────────────────────────
_main() {
    _load_modules

    # Tratamento de Argumentos CLI
    if [[ $# -gt 0 ]]; then
        case "$1" in
            --manual|manual)
                _show_manual
                exit 0
                ;;
            --clean|clean|cleanup)
                shift
                _dispatch "purge_gaming_bloat" "Não foi possível executar a limpeza." "$@"
                exit 0
                ;;
            --wine|wine)
                shift
                if [[ $# -eq 0 ]]; then
                    _dispatch "menu_wine_central" "Módulo Wine indisponível."
                else
                    _dispatch "run_wine_cli" "Comando Wine indisponível." "$@"
                fi
                exit 0
                ;;
            --retro|retro)
                shift
                if [[ $# -eq 0 ]]; then
                    _dispatch "menu_retro_central" "Módulo Retro indisponível."
                else
                    _dispatch "run_retro_cli" "Comando Retro indisponível." "$@"
                fi
                exit 0
                ;;
            --input|input)
                shift
                if [[ $# -eq 0 ]]; then
                    _dispatch "menu_input_central" "Módulo Input indisponível."
                else
                    _dispatch "run_input_cli" "Comando Input indisponível." "$@"
                fi
                exit 0
                ;;
            --version|-v)
                echo "Sambox 2 Engine v${SAMBOX_VERSION} — por Sam Moreno"
                exit 0
                ;;
            --help|-h)
                _show_help
                exit 0
                ;;
            *)
                _err "Argumento desconhecido: $1"
                _show_help
                exit 1
                ;;
        esac
    fi

    # Inicia a TUI interativa caso nenhum argumento CLI tenha sido informado
    clear 2>/dev/null || true
    _main_menu
}

# Dispara a execução repassando os parâmetros de terminal
_main "$@"
