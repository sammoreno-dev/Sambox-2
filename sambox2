set -euo pipefail

# ── Ajuste de PATH para Utilitários de Sistema (/sbin, /usr/sbin) ───────────
export PATH="${PATH}:/sbin:/usr/sbin:/usr/local/sbin"

# ── Resolução de Diretório Real (Suporte Total a Symlinks no $PATH) ─────────
_resolve_sambox_dir() {
    local source="${BASH_SOURCE[0]}"
    local dir=""
    while [[ -L "${source}" ]]; do
        dir="$(cd -P "$(dirname "${source}")" >/dev/null 2>&1 && pwd)"
        source="$(readlink "${source}")"
        [[ ${source} != /* ]] && source="${dir}/${source}"
    done
    cd -P "$(dirname "${source}")" >/dev/null 2>&1 && pwd
}

# ── Constantes Globais ──────────────────────────────────────────────────────
readonly SAMBOX_VERSION="2.0.0"
readonly SAMBOX_DIR="$(_resolve_sambox_dir)"
readonly MODULES_DIR="${SAMBOX_DIR}/modules"

# ── Paleta de Cores e Estilos ANSI ──────────────────────────────────────────
readonly RST=$'\033[0m'
readonly BOLD=$'\033[1m'
readonly RED=$'\033[0;31m'
readonly GREEN=$'\033[0;32m'
readonly YELLOW=$'\033[0;33m'
readonly CYAN=$'\033[0;36m'
readonly BLUE=$'\033[0;34m'
readonly MAGENTA=$'\033[0;35m'
readonly DIM=$'\033[2m'

# Exporta constantes visuais para uso compartilhado nos módulos
export RST BOLD RED GREEN YELLOW CYAN BLUE MAGENTA DIM
export SAMBOX_VERSION SAMBOX_DIR MODULES_DIR

# ── Restauração Segura do Terminal em Cancelamentos (Ctrl+C) ───────────────
_cleanup() {
    tput cnorm 2>/dev/null || true
    printf "\n${YELLOW}[!]${RST} Execução interrompida pelo usuário. Saindo do Sambox 2...\n"
    exit 130
}
trap _cleanup SIGINT SIGTERM

# ── Helpers Visuais da Interface (UI) ──────────────────────────────────────
_banner() {
    printf '\n'
    printf "${CYAN}${BOLD}"
    printf '  ╔═══════════════════════════════════════════╗\n'
    printf '  ║           🎮  S A M B O X  2  v%-10s║\n' "${SAMBOX_VERSION}"
    printf '  ║   Gaming, Emulation & Low-Level Tuning    ║\n'
    printf '  ╚═══════════════════════════════════════════╝\n'
    printf "${RST}\n"
}

_msg()  { printf "${GREEN}[✔]${RST} %s\n" "$1"; }
_warn() { printf "${YELLOW}[!]${RST} %s\n" "$1"; }
_err()  { printf "${RED}[✖]${RST} %s\n" "$1" >&2; }
_sep()  { printf "${DIM}────────────────────────────────────────────────${RST}\n"; }

export -f _msg _warn _err _sep

# ── Exibição em Pager Resistente a Falhas ──────────────────────────────────
_pager_view() {
    local content="$1"
    if command -v less &>/dev/null; then
        printf "%s" "${content}" | less -R
    elif command -v more &>/dev/null; then
        printf "%s" "${content}" | more
    else
        printf "%s" "${content}"
    fi
}

