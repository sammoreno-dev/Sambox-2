set -euo pipefail

# ── Ajuste de PATH para Utilitários de Sistema (/sbin, /usr/sbin) ───────────
export PATH="${PATH}:/sbin:/usr/sbin:/usr/local/sbin"

# 1. Resolução Absoluta de Diretório Real (Suporte Total a Symlinks no $PATH) ─
_resolve_sambox_dir() {
    local source="${BASH_SOURCE[0]}" dir=""
    while [[ -L "${source}" ]]; do
        dir="$(cd -P "$(dirname "${source}")" >/dev/null 2>&1 && pwd)"
        source="$(readlink "${source}")"
        [[ ${source} != /* ]] && source="${dir}/${source}"
    done
    cd -P "$(dirname "${source}")" >/dev/null 2>&1 && pwd
}

# ── Constantes Globais de Ambiente ──────────────────────────────────────────
export SAMBOX_VERSION="2.0.0"
export SAMBOX_DIR="$(_resolve_sambox_dir)"
export MODULES_DIR="${SAMBOX_DIR}/modules"

# ── Paleta de Cores e Estilos ANSI (Identidade Visual Gamer Ciano) ───────────
export RST='\033[0m' BOLD='\033[1m' DIM='\033[2m'
export RED='\033[0;31m' GREEN='\033[0;32m' YELLOW='\033[0;33m' CYAN='\033[0;36m'

# 2. Infraestrutura de Auto-Registro Dinâmico (Filosofia Sambox 2)
declare -g -a SAMBOX_MODULE_NAMES=()
declare -g -a SAMBOX_MODULE_FUNCS=()

register_sambox_module() {
    SAMBOX_MODULE_NAMES+=("$1")
    SAMBOX_MODULE_FUNCS+=("$2")
}

# 3. Função de Hot-Reload (Carregamento Inteligente e Limpeza de Estado)
reload_sambox_modules() {
    SAMBOX_MODULE_NAMES=()
    SAMBOX_MODULE_FUNCS=()
    if [[ -d "${MODULES_DIR}" ]]; then
        for module in "${MODULES_DIR}"/m_*.sh; do
            local mod_name="${module##*/}"
            # Ignora o menu principal e a si mesmo no loop automático
            [[ -f "${module}" && "${mod_name}" != "m_mainmenu.sh" && "${mod_name}" != "m_reload.sh" ]] && source "${module}"
        done
    fi
}

# Realiza a primeira injeção de ambiente na inicialização
reload_sambox_modules

# 4. Helpers Visuais Globais da Interface (UI) e Sinais
_msg()  { printf "  ${GREEN}[✔]${RST} %s\n" "$1"; }
_warn() { printf "  ${YELLOW}[!]${RST} %s\n" "$1"; }
_err()  { printf "  ${RED}[✖]${RST} %s\n" "$1" >&2; return 1; }
_sep()  { printf "  ${DIM}────────────────────────────────────────────────${RST}\n"; }

_cleanup() {
    tput cnorm 2>/dev/null || true
    printf "${RST}\n  ${YELLOW}[!]${RST} Execução interrompida! Saindo do Sambox 2 de forma pacífica... Bom jogo! 🕹️\n"
    exit 130
}
trap _cleanup SIGINT SIGTERM

_pager_view() {
    local content="$1"
    if command -v less &>/dev/null; then printf "%s" "${content}" | less -R
    elif command -v more &>/dev/null; then printf "%s" "${content}" | more
    else printf "%s" "${content}"; fi
}

# Garante o carregamento dos controladores visuais por último
[[ -f "${MODULES_DIR}/m_manual.sh" ]] && source "${MODULES_DIR}/m_manual.sh"
[[ -f "${MODULES_DIR}/m_mainmenu.sh" ]] && source "${MODULES_DIR}/m_mainmenu.sh"

# ── 5. Catálogo Único de Parâmetros e Motor de Despacho Otimizado ────────────
_dispatch_cli_or_tui() {
    local flag="$1"
    shift || true

    # Catálogo Mestre: Flag | Função TUI | Função CLI | Nome do Módulo
    local cli_catalog=(
        "--manual|show_manual_menu|show_manual_menu|Manual de Instruções"
        "--clean|purge_gaming_bloat|purge_gaming_bloat|Limpeza & Faxina"
        "--wine|menu_wine_central|run_wine_cli|Orquestrador Wine"
        "--retro|menu_retro_central|run_retro_cli|Central Retro"
        "--input|menu_input_central|run_input_cli|Diagnóstico de Inputs"
    )

    local entry="" f_flag="" tui_func="" cli_func="" mod_label=""
    for entry in "${cli_catalog[@]}"; do
        IFS='|' read -r f_flag tui_func cli_func mod_label <<< "${entry}"
        if [[ "${f_flag}" == "${flag}" ]]; then
            # Se o usuário não passou argumentos extras, tenta abrir a TUI do módulo, senão roda a CLI
            local target_func="${tui_func}"
            [[ $# -gt 0 ]] && target_func="${cli_func}"

            if declare -f "${target_func}" >/dev/null 2>&1; then
                "${target_func}" "$@"
                exit 0
            else
                _err "Puxa, a rotina do módulo [${mod_label}] não está carregada na memória."
                printf "     Certifique-se de que o arquivo m_*.sh existe e não possui erros de sintaxe. 🛠️\n"
                exit 1
            fi
        fi
    done

    _err "Sinalizador desconhecido ou inválido: ${flag}"
    _show_help
    exit 1
}

_show_help() {
    printf "${CYAN}${BOLD}Sambox 2 Engine v${SAMBOX_VERSION}${RST} — Toolbox Gamer Minimalista por Sam Moreno\n"
    echo "Uso: sambox2 [sinalizador] [argumentos]"
    echo ""
    echo "Sinalizadores de Retaguarda:"
    echo "  --manual        Abre o leitor interativo de instruções e tuning"
    echo "  --clean         Executa a limpeza de caches de shaders e temporários"
    echo "  --wine          Invoca a Central Wine (ex: --wine diag, --wine launch <exe>)"
    echo "  --retro         Invoca a Central Retro (ex: --retro emulators, --retro init)"
    echo "  --input         Invoca o diagnóstico de controles (ex: --input list)"
    echo "  -v, --version   Exibe a versão estável do Sambox 2"
    echo "  -h, --help      Exibe este menu de ajuda com os barramentos"
}

# ── 6. Ponto de Entrada Central (Main lifecycle) ───────────────────────────
_main() {
    if [[ $# -gt 0 ]]; then
        case "$1" in
            -v|--version) echo "Sambox 2 Engine v${SAMBOX_VERSION} — por Sam Moreno. Liberdade digital. ツ"; exit 0 ;;
            -h|--help) _show_help; exit 0 ;;
            *) _dispatch_cli_or_tui "$@" ;;
        esac
    else
        # Inicialização interativa calorosa se chamado puramente sem argumentos
        if declare -f menu_principal_tui >/dev/null 2>&1; then
            printf "\n  ${CYAN}[+] Aquecendo os motores gráficos e escaneando os barramentos... 🏎️${RST}\n"
            sleep 0.4
            menu_principal_tui
        else
            _err "Interface Visual Principal (m_mainmenu.sh) indisponível no barramento central."
            exit 1
        fi
    fi
}

_main "$@"

